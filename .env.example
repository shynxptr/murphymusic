# Discord Bot Configuration
# Get token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Client ID from Discord Developer Portal > General Information
CLIENT_ID=your_client_id_here

# Lavalink node configuration
# Download Lavalink from: https://github.com/lavalink-devs/Lavalink/releases
# Run it with: java -jar Lavalink.jar
LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=yournamelavalink
LAVALINK_SECURE=false

# Optional: Spotify credentials for Spotify search support
# Get from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Prefix for prefix-based commands (optional, slash commands are primary)
PREFIX=!
