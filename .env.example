# Discord Bot Configuration
# Get token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Client ID from Discord Developer Portal > General Information
CLIENT_ID=your_client_id_here

# Lavalink node configuration (local host 127.0.0.1)
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false

# Default prefix for commands (can be changed per server using f!prefix)
PREFIX=f!
